.message-content {
  line-height: 1.6;
  max-width: 100%;
}

/* Paragraphs */
.message-content p {
  margin: 0 0 8px 0;
}

.message-content p:last-child {
  margin-bottom: 0;
}

/* Headings */
.message-content h1,
.message-content h2,
.message-content h3,
.message-content h4 {
  margin: 16px 0 8px 0;
  font-weight: 600;
  color: var(--colorNeutralForeground1);
}

.message-content h1:first-child,
.message-content h2:first-child,
.message-content h3:first-child {
  margin-top: 0;
}

.message-content h2 {
  font-size: 1.1em;
  border-bottom: 1px solid var(--colorNeutralStroke2);
  padding-bottom: 4px;
}

.message-content h3 {
  font-size: 1em;
}

/* Strong/Bold text */
.message-content strong {
  font-weight: 600;
  color: var(--colorNeutralForeground1);
}

/* Lists */
.message-content ul {
  margin: 8px 0;
  padding-left: 20px;
  list-style-type: disc;
}

.message-content ul li {
  margin: 4px 0;
  padding-left: 4px;
}

.message-content ul li::marker {
  color: var(--colorBrandForeground1);
}

/* Inline code */
.message-content code {
  font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
  background-color: rgba(0, 0, 0, 0.08);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.9em;
}

/* Code blocks */
.message-content .code-block {
  margin: 12px 0;
  border-radius: 8px;
  overflow: hidden;
  background-color: #1e1e1e;
  border: 1px solid var(--colorNeutralStroke2);
}

/* ========================= */
/* TABLE RESULT SET (FIXED) */
/* ========================= */

/* Scroll container — ONLY this scrolls */
.message-content .chat-table-wrapper {
  max-height: 320px;
  overflow: auto;
  margin: 12px 0;
}

/* Normal table layout (single layout context) */
.message-content table {
  border-collapse: collapse;
  width: max-content;
  min-width: 100%;
  table-layout: auto;
  font-size: 0.9em;
}

/* Sticky header */
.message-content thead th {
  position: sticky;
  top: 0;
  z-index: 2;
  background-color: var(--colorNeutralBackground3);
}

/* Cells */
.message-content th,
.message-content td {
  border: 1px solid var(--colorNeutralStroke2);
  padding: 8px 12px;
  text-align: left;
  white-space: nowrap;
}

/* Alternate rows */
.message-content tbody tr:nth-child(even) {
  background-color: var(--colorNeutralBackground2);
}

/* Links */
.message-content a {
  color: var(--colorBrandForeground1);
  text-decoration: none;
  font-weight: 500;
}

.message-content a:hover {
  text-decoration: underline;
}

/* Horizontal rule */
.message-content hr {
  border: none;
  border-top: 1px solid var(--colorNeutralStroke2);
  margin: 16px 0;
}

.file-download-link {
  margin: 4px 0;
}
